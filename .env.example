# Local stack identity
COMPOSE_PROJECT_NAME=renewi-contractor-access
APP_ENV=development
RENEWI_ENV=local

# Local PostgreSQL uses Docker development-only trust authentication.
POSTGRES_DB=renewi_access
POSTGRES_USER=renewi
POSTGRES_PORT=5432
DATABASE_URL=

# Local Redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Application addresses
FRONTEND_PORT=3000
BACKEND_PORT=8000
# In Docker, the browser uses this same-origin Next.js proxy path.
NEXT_PUBLIC_API_URL=/backend
# Docker-internal FastAPI address used only by the Next.js server rewrite.
BACKEND_INTERNAL_URL=http://backend:8000

# Credential-free adapter defaults
AUTH_PROVIDER=demo
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/var/lib/renewi/evidence
OCR_PROVIDER=mock
IDENTITY_VERIFIER_PROVIDER=mock
NOTIFICATION_PROVIDER=mock
HR_INTEGRATION_PROVIDER=mock
AGENCY_INTEGRATION_PROVIDER=mock
FREIGHT_EXCHANGE_PROVIDER=mock
LMS_PROVIDER=mock
ACCESS_CONTROL_PROVIDER=mock

# Optional production-only configuration. Leave unset in local demo mode.
TOKEN_SIGNING_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO
